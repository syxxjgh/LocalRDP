<ui:FluentWindow x:Class="DeskClone.Views.LoginAccountDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="确认桌面分身登录账户"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Auto">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,14,0"
                               FontSize="28"
                               Foreground="#FF60B9F4"
                               Symbol="Person24"
                               VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="选择桌面分身登录的 Windows 账户" />
                    <TextBlock x:Name="CurrentAccountText"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Border x:Name="ExistingSessionBanner"
                    Margin="0,16,0,0"
                    Padding="12,10"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <TextBlock x:Name="ExistingSessionText"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Margin="0,18,0,6"
                       Text="登录账户" />
            <ComboBox x:Name="AccountComboBox"
                      HorizontalAlignment="Stretch"
                      IsEditable="True" />
            <TextBlock x:Name="ValidationText"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="#FFFF6B6B"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <TextBlock Margin="0,16,0,6"
                       Text="密码（可选，仅保存在本次运行内存中，不写入磁盘）" />
            <PasswordBox x:Name="PasswordInput" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="留空时将弹出 Windows 安全窗口并预填上方账户；填写密码可跳过 Windows 弹窗，切换分辨率重连时也无需重复输入。"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="ConfirmEachTimeCheckBox"
                      Margin="0,16,0,0"
                      Content="每次登录前确认登录账户" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button x:Name="ConfirmButton"
                       MinWidth="128"
                       Margin="0,0,12,0"
                       Appearance="Primary"
                       Click="OnConfirm"
                       Content="确认并登录"
                       IsDefault="True" />
            <ui:Button MinWidth="88"
                       Click="OnCancel"
                       Content="取消"
                       IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
